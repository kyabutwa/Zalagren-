{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "core/**/*.ts",
    "people/**/*.ts",
    "communities/**/*.ts",
    "places/**/*.ts",
    "organizations/**/*.ts",
    "providers/**/*.ts",
    "intelligence/**/*.ts",
    "services/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
